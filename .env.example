# Copy to .env and fill in. Never commit .env.

# Discord — create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=

# Server and channels (enable Developer Mode in Discord → right‑click channel → Copy ID)
GUILD_ID=
NEWS_CHANNEL_ID=
DEALS_CHANNEL_ID=

# RSS: comma-separated URLs (no spaces after commas, or encode spaces in URLs)
# Example Wowhead news (verify current URL in your browser):
RSS_URLS_NEWS=https://www.wowhead.com/news/rss/news-blizzard
# Optional: second feed for “deals” — add official or third‑party feeds you trust
RSS_URLS_DEALS=

# How often to poll RSS (cron: min hour dom mon dow) — default every 6 hours
CRON_RSS=0 */6 * * *

# Max embeds per run per channel (avoid spam if many new items)
MAX_POSTS_PER_RUN=5
